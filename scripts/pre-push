#!/bin/bash
# Pre-push hook — check if vault notes for CHANGED skills are outdated
# Scans only skills modified in this push (git diff origin/main..HEAD)
# Installs: ln -sf ../../scripts/pre-push .git/hooks/pre-push

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TRACE="$SCRIPT_DIR/hermes-behavior/scripts/vault-trace.py"

if [ ! -f "$TRACE" ]; then
    echo "⚠ vault-trace.py not found — skipping"
    exit 0
fi

# Find which skills were changed in this push
CHANGED=$(git diff --name-only origin/main..HEAD 2>/dev/null | grep -oP '^[^/]+(?=/SKILL\.md)' | sort -u)

if [ -z "$CHANGED" ]; then
    exit 0
fi

echo "🔍 Changed skills: $CHANGED"
STALE=0
for skill in $CHANGED; do
    python "$TRACE" "$skill" --stale || STALE=1
done

if [ $STALE -eq 1 ]; then
    echo ""
    echo "⚠ Some vault notes are outdated. Review before pushing."
    echo "   Use --stale --block in vault-trace.py to enforce blocking."
fi
exit 0  # warning only, never blocks
